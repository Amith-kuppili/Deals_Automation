# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/deal_hunter

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# E-COMMERCE / QUICKCOMMERCE
# ============================================================
ECOMMERCE_API_ENABLED=false
ECOMMERCE_API_BASE_URL=https://api.quickcommerce.io/v1
ECOMMERCE_API_KEY=
ECOMMERCE_API_TIMEOUT_SECONDS=30
ECOMMERCE_API_MAX_RETRIES=3
ECOMMERCE_API_MIN_CREDITS=5
ECOMMERCE_API_LOW_CREDITS_THRESHOLD=10

# ============================================================
# AMAZON PROVIDERS
# ============================================================
AMAZON_ENABLED=false
AMAZON_PRIMARY_PROVIDER=openwebninja
AMAZON_BACKUP_PROVIDER=brightdata
# Amazon marketplace country (US, IN, GB, DE, ...); also sets the currency
AMAZON_COUNTRY=IN

# OpenWeb Ninja
OPENWEBNINJA_ENABLED=false
OPENWEBNINJA_API_KEY=
OPENWEBNINJA_BASE_URL=https://api.openwebninja.com/realtime-amazon-data
OPENWEBNINJA_TIMEOUT_SECONDS=30
OPENWEBNINJA_MAX_RETRIES=3
OPENWEBNINJA_MONTHLY_REQUEST_LIMIT=100
OPENWEBNINJA_LOW_REQUEST_THRESHOLD=10

# Bright Data
BRIGHTDATA_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_TIMEOUT_SECONDS=30
BRIGHTDATA_MAX_RETRIES=3

# Other Providers
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# DEAL ENGINE
# ============================================================
DEAL_MIN_HISTORY_OBSERVATIONS=5
DEAL_HIGH_CONFIDENCE_HISTORY_OBSERVATIONS=20
DEAL_HISTORY_WINDOW_DAYS=30

# ============================================================
# REEFAPI
# ============================================================
REEFAPI_ENABLED=false
REEFAPI_API_KEY=
REEFAPI_BASE_URL=
REEFAPI_TIMEOUT_SECONDS=30
REEFAPI_MAX_RETRIES=3
REEFAPI_BOOTSTRAP_ENABLED=false
REEFAPI_BOOTSTRAP_COOLDOWN_HOURS=24
REEFAPI_LOW_CREDITS_THRESHOLD=100

